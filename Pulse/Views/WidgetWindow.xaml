<Window
    x:Class="TaskManagerPro.Views.WidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TaskManagerPro.Controls">

    <Grid x:Name="Root" RequestedTheme="Dark" Padding="14,0,10,14" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- نوار بالا (قابل درگ) -->
        <Grid x:Name="DragBar" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <controls:IconBadge Glyph="&#xE9D9;" Size="22" />
                <TextBlock Text="Pulse" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="ClockText" FontSize="13" Opacity="0.5" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        <Button x:Name="CloseBtn" Width="26" Height="26" Padding="0" CornerRadius="13"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                Background="#14FFFFFF" BorderThickness="0" Click="Close_Click"
                ToolTipService.ToolTip="Hide widget">
            <FontIcon Glyph="&#xE711;" FontSize="9" />
        </Button>

        <!-- سه گیج -->
        <Grid Grid.Row="1" ColumnSpacing="8" Margin="0,0,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border CornerRadius="12" Padding="6,12,6,10" Background="#0FFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1">
                <StackPanel Spacing="8">
                    <Grid Width="78" Height="78" HorizontalAlignment="Center">
                        <controls:RingGauge x:Name="CpuRing" Thickness="7" UseLoadColors="True" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="CpuValue" Text="—" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="{StaticResource DisplayFont}" />
                            <TextBlock Text="CPU" FontSize="10" Opacity="0.55" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="CpuDetail" Text=" " FontSize="11" Opacity="0.65" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" CornerRadius="12" Padding="6,12,6,10" Background="#0FFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1">
                <StackPanel Spacing="8">
                    <Grid Width="78" Height="78" HorizontalAlignment="Center">
                        <controls:RingGauge x:Name="RamRing" Thickness="7" UseLoadColors="True" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="RamValue" Text="—" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="{StaticResource DisplayFont}" />
                            <TextBlock Text="RAM" FontSize="10" Opacity="0.55" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="RamDetail" Text=" " FontSize="11" Opacity="0.65" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" CornerRadius="12" Padding="6,12,6,10" Background="#0FFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1">
                <StackPanel Spacing="8">
                    <Grid Width="78" Height="78" HorizontalAlignment="Center">
                        <controls:RingGauge x:Name="GpuRing" Thickness="7" UseLoadColors="True" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="GpuValue" Text="—" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="{StaticResource DisplayFont}" />
                            <TextBlock Text="GPU" FontSize="10" Opacity="0.55" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="GpuDetail" Text=" " FontSize="11" Opacity="0.65" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- شبکه + دما: سه قرص هم‌اندازه -->
        <Grid Grid.Row="2" ColumnSpacing="8" Margin="0,0,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border CornerRadius="10" Padding="8,6" Background="#0AFFFFFF">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE896;" FontSize="11" Foreground="#3DD68C" />
                    <TextBlock x:Name="DownText" Text="—" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" CornerRadius="10" Padding="8,6" Background="#0AFFFFFF">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE898;" FontSize="11" Foreground="#FFB547" />
                    <TextBlock x:Name="UpText" Text="—" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" CornerRadius="10" Padding="8,6" Background="#0AFFFFFF">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE9CA;" FontSize="11" Opacity="0.7" />
                    <TextBlock x:Name="TempText" Text="—" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
