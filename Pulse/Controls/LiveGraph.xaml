<UserControl
    x:Class="TaskManagerPro.Controls.LiveGraph"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" SizeChanged="RootGrid_SizeChanged" MinHeight="80">
        <!-- برش لبه‌ها: نقاطی که در حال ورود/خروج از گراف هستند بیرون قاب دیده نشوند -->
        <Grid.Clip>
            <RectangleGeometry x:Name="ClipGeometry" />
        </Grid.Clip>

        <!-- قاب دور گراف -->
        <Border BorderBrush="{ThemeResource PulseDividerBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Background="{ThemeResource PulseSurfaceBrush}" />

        <!-- خطوط راهنمای افقی (۲۵٪ / ۵۰٪ / ۷۵٪ محور عمودی) -->
        <Grid x:Name="GridLines" IsHitTestVisible="False" Opacity="0.6">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Rectangle Grid.Row="1" Height="1" VerticalAlignment="Top"
                       Fill="{ThemeResource PulseDividerBrush}" />
            <Rectangle Grid.Row="2" Height="1" VerticalAlignment="Top"
                       Fill="{ThemeResource PulseDividerBrush}" />
            <Rectangle Grid.Row="3" Height="1" VerticalAlignment="Top"
                       Fill="{ThemeResource PulseDividerBrush}" />
        </Grid>

        <!-- ناحیه‌ی پرشده‌ی زیر خط -->
        <Path x:Name="FillArea" Opacity="0.5" />

        <!-- خط اصلی گراف -->
        <Path x:Name="Line" StrokeThickness="2.25" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

        <!-- اعداد محور: سقف، وسط، کف + مقدار فعلی و بازه‌ی زمانی -->
        <Grid x:Name="AxisLayer" IsHitTestVisible="False" Margin="10,6,10,6">
            <TextBlock x:Name="MaxLabel" FontSize="10" Opacity="0.65"
                       HorizontalAlignment="Left" VerticalAlignment="Top" />
            <TextBlock x:Name="MidLabel" FontSize="10" Opacity="0.5"
                       HorizontalAlignment="Left" VerticalAlignment="Center" />
            <TextBlock x:Name="MinLabel" FontSize="10" Opacity="0.65"
                       HorizontalAlignment="Left" VerticalAlignment="Bottom" />
            <TextBlock x:Name="CurrentLabel" FontSize="13" FontWeight="SemiBold" Opacity="0.95"
                       HorizontalAlignment="Right" VerticalAlignment="Top" />
            <TextBlock x:Name="SpanLabel" FontSize="10" Opacity="0.55"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom" />
        </Grid>
    </Grid>
</UserControl>
