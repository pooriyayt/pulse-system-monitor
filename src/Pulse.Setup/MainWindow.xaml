<Window x:Class="Pulse.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pulse Setup" Width="760" Height="500"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None"
        Background="Transparent" UseLayoutRounding="True"
        FontFamily="{DynamicResource UiFont}"
        TextOptions.TextFormattingMode="Ideal">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" GlassFrameThickness="-1" ResizeBorderThickness="0" UseAeroCaptionButtons="False" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root" ClipToBounds="True">
        <!-- opaque gradient on Windows 10, translucent over acrylic on Windows 11 -->
        <Border x:Name="Backdrop">
            <Border.Background>
                <LinearGradientBrush x:Name="BackdropBrush" StartPoint="1,0" EndPoint="0,1">
                    <GradientStop Color="#FF0C1A22" Offset="0" />
                    <GradientStop Color="#FF09111A" Offset="0.6" />
                    <GradientStop Color="#FF060B12" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Ellipse Width="520" Height="520" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-160,-220,0,0" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#5534D399" Offset="0" />
                    <GradientStop Color="#0034D399" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="560" Height="560" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-240,-300" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#4438BDF8" Offset="0" />
                    <GradientStop Color="#0038BDF8" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- caption -->
            <Grid Margin="18,0,10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" FlowDirection="LeftToRight">
                    <Border Width="24" Height="24" CornerRadius="7">
                        <Border.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Assets/icon.png" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <TextBlock x:Name="CaptionText" Style="{StaticResource Base}" Margin="10,0,0,0" FontSize="13" Foreground="#CBD5E1" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" FlowDirection="LeftToRight">
                    <Button Style="{StaticResource CaptionButton}" WindowChrome.IsHitTestVisibleInChrome="True" Click="Min_Click">
                        <Path Data="M0,0 L10,0" Stroke="#CBD5E1" StrokeThickness="1.4" />
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource CaptionButton}" WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="#CBD5E1" StrokeThickness="1.4" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ================= Welcome ================= -->
            <Grid x:Name="WelcomePage" Grid.Row="1" Margin="44,8,44,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="230" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Base}" Text="Pulse" FontSize="46" FontWeight="Bold" Foreground="{StaticResource AccentText}" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                    <TextBlock x:Name="TaglineText" Style="{StaticResource Base}" FontSize="15" Foreground="#E2E8F0" Margin="0,2,0,14" TextWrapping="Wrap" />
                    <TextBlock x:Name="Feature1" Style="{StaticResource Base}" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,2" />
                    <TextBlock x:Name="Feature2" Style="{StaticResource Base}" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,2" />
                    <TextBlock x:Name="Feature3" Style="{StaticResource Base}" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,2,0,22" />

                    <StackPanel>
                        <CheckBox x:Name="DesktopBox" Style="{StaticResource Toggle}" IsChecked="True" Margin="0,4" />
                        <CheckBox x:Name="LaunchBox" Style="{StaticResource Toggle}" IsChecked="True" Margin="0,4" />
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Ellipse Width="260" Height="260">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#6634D399" Offset="0" />
                                <GradientStop Color="#0034D399" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Border Width="150" Height="150" CornerRadius="40" BorderThickness="2" BorderBrush="#9934D399" RenderTransformOrigin="0.5,0.5" FlowDirection="LeftToRight">
                        <Border.RenderTransform><TranslateTransform x:Name="LogoFloat" /></Border.RenderTransform>
                        <Border.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Assets/icon.png" Stretch="UniformToFill" />
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="#34D399" BlurRadius="40" ShadowDepth="0" Opacity="0.45" />
                        </Border.Effect>
                    </Border>
                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,-4" CornerRadius="10" Padding="10,3" Background="#2634D399" BorderBrush="#5934D399" BorderThickness="1">
                        <TextBlock x:Name="VersionText" Style="{StaticResource Base}" FontSize="12" FontWeight="Bold" Foreground="#6EE7B7" />
                    </Border>
                </Grid>
            </Grid>

            <!-- ================= Progress ================= -->
            <StackPanel x:Name="ProgressPage" Grid.Row="1" Margin="60,0" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="ProgressTitle" Style="{StaticResource Base}" FontSize="26" FontWeight="Bold" />
                <TextBlock x:Name="PercentText" Style="{StaticResource Base}" FontSize="56" FontWeight="Bold" Foreground="{StaticResource AccentText}" Margin="0,6,0,10" FlowDirection="LeftToRight" HorizontalAlignment="Right" />
                <Grid Height="12" FlowDirection="LeftToRight">
                    <Border CornerRadius="6" Background="#1FFFFFFF" />
                    <Border x:Name="Bar" CornerRadius="6" Background="{StaticResource Accent}" HorizontalAlignment="Left" Width="0">
                        <Border.Effect>
                            <DropShadowEffect Color="#34D399" BlurRadius="16" ShadowDepth="0" Opacity="0.7" />
                        </Border.Effect>
                    </Border>
                </Grid>
                <TextBlock x:Name="StatusText" Style="{StaticResource Base}" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,12,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- ================= Done / error ================= -->
            <StackPanel x:Name="DonePage" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <Grid Width="110" Height="110" HorizontalAlignment="Center" FlowDirection="LeftToRight">
                    <Ellipse x:Name="DoneCircle" Fill="#2630D158" Stroke="#30D158" StrokeThickness="2" />
                    <Path x:Name="DoneMark" Data="M30,57 L48,74 L82,38" Stroke="#30D158" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Grid>
                <TextBlock x:Name="DoneTitle" Style="{StaticResource Base}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,20,0,6" />
                <ScrollViewer MaxHeight="120" MaxWidth="600" VerticalScrollBarVisibility="Auto" HorizontalAlignment="Center">
                    <TextBlock x:Name="DoneText" Style="{StaticResource Base}" FontSize="14" Foreground="#CBD5E1" TextAlignment="Center" TextWrapping="Wrap" />
                </ScrollViewer>
            </StackPanel>

            <!-- ================= Footer ================= -->
            <Grid Grid.Row="2" Margin="44,0,44,26">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock x:Name="MadeByText" Style="{StaticResource Base}" FontSize="11.5" Foreground="{StaticResource Muted}" />
                    <TextBlock Style="{StaticResource Base}" FontSize="11.5" Foreground="{StaticResource Muted}" FlowDirection="LeftToRight" HorizontalAlignment="Left" Cursor="Hand" MouseLeftButtonUp="Site_Click" Text="pouriyaparniyan.ir" TextDecorations="Underline" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SecondaryButton" Style="{StaticResource GlassButton}" Margin="0,0,10,0" Click="Secondary_Click" />
                    <Button x:Name="PrimaryButton" Style="{StaticResource PrimaryButton}" Click="Primary_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
