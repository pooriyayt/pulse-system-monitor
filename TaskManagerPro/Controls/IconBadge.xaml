<UserControl
    x:Class="TaskManagerPro.Controls.IconBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <!-- آیکون «اسکوئرکل» رنگی به سبک System Settings مک -->
    <Grid x:Name="Root" Width="40" Height="40">
        <Border x:Name="Fill" CornerRadius="11" />
        <!-- برق شیشه‌ای بالای آیکون -->
        <Border x:Name="Shine" CornerRadius="11" BorderThickness="1">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#66FFFFFF" />
                    <GradientStop Offset="0.5" Color="#10FFFFFF" />
                    <GradientStop Offset="1" Color="#00FFFFFF" />
                </LinearGradientBrush>
            </Border.BorderBrush>
        </Border>
        <FontIcon x:Name="Icon" FontSize="18" Foreground="White" />
    </Grid>
</UserControl>
