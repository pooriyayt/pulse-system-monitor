<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TaskManagerPro.Views.ProcessesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:TaskManagerPro.Models"
    xmlns:controls="using:TaskManagerPro.Controls"
    NavigationCacheMode="Required"
    KeyboardAcceleratorPlacementMode="Hidden">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FindAccel"/>
        <KeyboardAccelerator Key="F5" Invoked="RefreshAccel"/>
        <KeyboardAccelerator Key="Delete" Invoked="DeleteAccel"/>
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <!-- منوی کلیک راست روی هر پردازه -->
        <MenuFlyout x:Name="ProcessMenu">
            <MenuFlyoutItem x:Name="MenuEndTask" Text="End task" Click="EndTask_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE711;"/>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSubItem Text="Set priority">
                <MenuFlyoutSubItem.Icon>
                    <FontIcon Glyph="&#xE9E9;"/>
                </MenuFlyoutSubItem.Icon>
                <MenuFlyoutItem Text="Realtime" Tag="realtime" Click="Priority_Click"/>
                <MenuFlyoutItem Text="High" Tag="high" Click="Priority_Click"/>
                <MenuFlyoutItem Text="Above normal" Tag="abovenormal" Click="Priority_Click"/>
                <MenuFlyoutItem Text="Normal" Tag="normal" Click="Priority_Click"/>
                <MenuFlyoutItem Text="Below normal" Tag="belownormal" Click="Priority_Click"/>
                <MenuFlyoutItem Text="Low" Tag="low" Click="Priority_Click"/>
            </MenuFlyoutSubItem>
            <MenuFlyoutSeparator/>
            <MenuFlyoutItem x:Name="MenuSuspend" Text="Suspend" Click="Suspend_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE769;"/>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="MenuResume" Text="Resume" Click="Resume_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE768;"/>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="MenuEco" Text="Efficiency mode" Click="Efficiency_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8BE;"/>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator/>
            <MenuFlyoutItem x:Name="MenuCopy" Text="Copy details" Click="CopyDetails_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8C8;"/>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator x:Name="MenuLocationSep"/>
            <MenuFlyoutItem x:Name="MenuOpenLocation" Text="Open file location" Click="OpenLocation_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE838;"/>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Properties" Click="Properties_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE946;"/>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </Page.Resources>

    <Grid Padding="32,24,32,20" RowSpacing="14">
        <!-- ریسپانسیو: در عرض کم دکمه‌های عملیات زیر عنوان می‌روند -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideToolbar">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1220"/>
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowToolbar">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ActionTools.(Grid.Column)" Value="0"/>
                        <Setter Target="ActionTools.(Grid.Row)" Value="1"/>
                        <Setter Target="ActionTools.HorizontalAlignment" Value="Left"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="24"/>
                <RepositionThemeTransition/>
            </TransitionCollection>
        </Grid.ChildrenTransitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- سرتیتر صفحه + دکمه‌های عملیات -->
        <Grid x:Name="Toolbar" ColumnSpacing="16" RowSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="14">
                <controls:IconBadge Glyph="&#xE9F5;" Size="44"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PageTitle" Text="Processes" Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock x:Name="StatusText" Style="{StaticResource PageSubtitleStyle}" Text=" "/>
                </StackPanel>
            </StackPanel>

            <!-- گروه دکمه‌های عملیات -->
            <StackPanel x:Name="ActionTools" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center" HorizontalAlignment="Right">
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="Refresh_Click" ToolTipService.ToolTip="Refresh (F5)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                        <TextBlock x:Name="RefreshBtnLabel" Text="Refresh"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ToolbarButtonStyle}" Click="ExportCsv_Click" ToolTipService.ToolTip="Export the process list to a CSV file">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xEDE1;" FontSize="14"/>
                        <TextBlock x:Name="ExportLabel" Text="Export CSV"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14"/>
                        <TextBlock x:Name="RunTaskLabel" Text="Run new task"/>
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout x:Name="RunFlyout">
                            <StackPanel Spacing="10" Width="280">
                                <TextBlock x:Name="RunFlyoutTitle" Text="Open" Style="{StaticResource CardTitleStyle}"/>
                                <TextBox x:Name="RunInput" PlaceholderText="e.g. notepad, cmd, mspaint"/>
                                <Button x:Name="RunBtn" Content="Run" HorizontalAlignment="Right" Style="{StaticResource AccentPillButtonStyle}" Click="RunTask_Click"/>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- دکمه‌ی سریع End task برای پردازه‌ی انتخاب‌شده -->
                <Button
                    x:Name="EndTaskBtn"
                    IsEnabled="False"
                    Click="EndTask_Click"
                    Style="{StaticResource DangerButtonStyle}"
                    ToolTipService.ToolTip="End the selected task (Delete)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE711;" FontSize="13"/>
                        <TextBlock x:Name="EndTaskLabel" Text="End task"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- هشدار نیاز به دسترسی ادمین برای ستون Network -->
        <InfoBar
            x:Name="AdminBar"
            Grid.Row="1"
            Severity="Informational"
            IsOpen="False"
            Title="Run as administrator"
            Message="Per-process network usage needs administrator rights. Right-click the app and choose 'Run as administrator' to unlock the Network column."/>

        <!-- جستجو و فیلتر -->
        <StackPanel x:Name="SearchTools" Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Grid>
                <TextBox
                    x:Name="SearchBox"
                    Width="300"
                    Padding="36,6,10,6"
                    PlaceholderText="Search processes  (Ctrl+F)"
                    TextChanged="Search_TextChanged"/>
                <FontIcon Glyph="&#xE721;" FontSize="14" Margin="12,0,0,0"
                          HorizontalAlignment="Left" VerticalAlignment="Center"
                          Foreground="{ThemeResource PulseMutedTextBrush}" IsHitTestVisible="False"/>
            </Grid>

            <ComboBox x:Name="SortCombo" MinWidth="150" SelectionChanged="Sort_Changed">
                <ComboBoxItem Content="Sort: CPU"/>
                <ComboBoxItem Content="Sort: Memory"/>
                <ComboBoxItem Content="Sort: Disk"/>
                <ComboBoxItem Content="Sort: Network"/>
                <ComboBoxItem Content="Sort: GPU"/>
                <ComboBoxItem Content="Sort: Name"/>
                <ComboBoxItem Content="Sort: PID"/>
            </ComboBox>

            <!-- فیلتر پیشرفته -->
            <ComboBox x:Name="FilterCombo" MinWidth="170" SelectionChanged="Sort_Changed">
                <ComboBoxItem Content="Filter: All"/>
                <ComboBoxItem Content="Filter: Apps only"/>
                <ComboBoxItem Content="Filter: CPU &gt; 1%"/>
                <ComboBoxItem Content="Filter: Memory &gt; 100 MB"/>
                <ComboBoxItem Content="Filter: Active network"/>
            </ComboBox>
        </StackPanel>

        <InfoBar x:Name="ErrorBar" Grid.Row="3" Severity="Error" IsOpen="False" Title="Error"/>

        <!-- جدول پردازه‌ها -->
        <Border Grid.Row="4" Style="{StaticResource TableCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- سرستون‌ها -->
                <Border Style="{StaticResource TableHeaderBorderStyle}" Padding="0,11">
                    <Grid ColumnSpacing="8" Padding="52,0,22,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="76"/>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="64"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ColName" Text="Name" Style="{StaticResource ColumnHeaderStyle}"/>
                        <TextBlock x:Name="ColPid" Grid.Column="1" Text="PID" Style="{StaticResource ColumnHeaderStyle}" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="ColCpu" Grid.Column="2" Text="CPU" Style="{StaticResource ColumnHeaderStyle}" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                        <TextBlock x:Name="ColMemory" Grid.Column="3" Text="Memory" Style="{StaticResource ColumnHeaderStyle}" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                        <TextBlock x:Name="ColDisk" Grid.Column="4" Text="Disk" Style="{StaticResource ColumnHeaderStyle}" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                        <TextBlock x:Name="ColNetwork" Grid.Column="5" Text="Network" Style="{StaticResource ColumnHeaderStyle}" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                        <TextBlock x:Name="ColGpu" Grid.Column="6" Text="GPU" Style="{StaticResource ColumnHeaderStyle}" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    </Grid>
                </Border>

                <!-- درخت پردازه‌ها + لودینگ -->
                <Grid Grid.Row="1" Padding="6">
                    <TreeView
                        x:Name="ProcessTree"
                        ItemsSource="{x:Bind Roots}"
                        SelectionMode="Single"
                        CanDragItems="False"
                        CanReorderItems="False"
                        AllowDrop="False"
                        ItemInvoked="Tree_ItemInvoked">
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="models:ProcessNode">
                                <TreeViewItem
                                    ItemsSource="{x:Bind Children}"
                                    IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                    RightTapped="Row_RightTapped"
                                    MinHeight="38">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="76"/>
                                            <ColumnDefinition Width="92"/>
                                            <ColumnDefinition Width="92"/>
                                            <ColumnDefinition Width="92"/>
                                            <ColumnDefinition Width="64"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Grid Width="20" Height="20" VerticalAlignment="Center">
                                                <FontIcon Glyph="{x:Bind FallbackGlyph, Mode=OneWay}" FontSize="15" Visibility="{x:Bind FallbackVisibility, Mode=OneWay}"
                                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                <Image Source="{x:Bind Icon, Mode=OneWay}" Width="20" Height="20"/>
                                            </Grid>
                                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="{x:Bind NameWeight, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <!-- برگ سبز Efficiency mode مثل Task Manager ویندوز -->
                                            <FontIcon
                                                Glyph="&#xE8BE;"
                                                FontSize="12"
                                                Foreground="{StaticResource PulseOkBrush}"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind EcoVisibility, Mode=OneWay}"
                                                ToolTipService.ToolTip="Efficiency mode"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{x:Bind PidText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource PulseMutedTextBrush}" FontSize="12"/>
                                        <!-- خانه‌های رنگی بر اساس شدت مصرف (نقشه‌ی حرارتی) -->
                                        <Border Grid.Column="2" Background="{x:Bind CpuHeat, Mode=OneWay}" CornerRadius="6" Padding="8,3">
                                            <TextBlock Text="{x:Bind CpuText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Column="3" Background="{x:Bind MemHeat, Mode=OneWay}" CornerRadius="6" Padding="8,3">
                                            <TextBlock Text="{x:Bind MemText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Column="4" Background="{x:Bind DiskHeat, Mode=OneWay}" CornerRadius="6" Padding="8,3">
                                            <TextBlock Text="{x:Bind DiskText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Column="5" CornerRadius="6" Padding="8,3">
                                            <TextBlock Text="{x:Bind NetText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource PulseMutedTextBrush}"/>
                                        </Border>
                                        <Border Grid.Column="6" Background="{x:Bind GpuHeat, Mode=OneWay}" CornerRadius="6" Padding="8,3">
                                            <TextBlock Text="{x:Bind GpuText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </TreeViewItem>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <!-- لودینگ اولین بارگذاری -->
                    <Grid x:Name="LoadingOverlay">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                            <ProgressRing IsActive="True" Width="44" Height="44"/>
                            <TextBlock x:Name="LoadingText" Text="Loading processes..." Style="{StaticResource PageSubtitleStyle}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
