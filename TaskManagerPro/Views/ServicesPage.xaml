<Page
    x:Class="TaskManagerPro.Views.ServicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:TaskManagerPro.Models"
    xmlns:controls="using:TaskManagerPro.Controls"
    NavigationCacheMode="Required"
    KeyboardAcceleratorPlacementMode="Hidden">

    <!-- هات‌کی‌های این صفحه -->
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FindAccel_Invoked" />
        <KeyboardAccelerator Key="F5" Invoked="RefreshAccel_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid Padding="32,24,32,20" RowSpacing="16">
        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="24" />
            </TransitionCollection>
        </Grid.ChildrenTransitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- سرتیتر -->
        <StackPanel Orientation="Horizontal" Spacing="14">
            <controls:IconBadge Glyph="&#xE912;" Size="44" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="ServicesTitle" Text="Services" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="ServicesSubtitle" Text="Start, stop and restart Windows services"
                           Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
        </StackPanel>

        <!-- جستجو + رفرش -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Grid>
                <TextBox x:Name="SearchBox"
                         PlaceholderText="Search services...  (Ctrl+F)"
                         Width="320"
                         Padding="36,6,10,6"
                         TextChanged="SearchBox_TextChanged" />
                <FontIcon Glyph="&#xE721;" FontSize="14" Margin="12,0,0,0"
                          HorizontalAlignment="Left" VerticalAlignment="Center"
                          Foreground="{ThemeResource PulseMutedTextBrush}" IsHitTestVisible="False" />
            </Grid>
            <Button Style="{StaticResource ToolbarButtonStyle}" Click="Refresh_Click" ToolTipService.ToolTip="Refresh (F5)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock x:Name="RefreshLabel" Text="Refresh" />
                </StackPanel>
            </Button>
        </StackPanel>

        <InfoBar x:Name="ErrorBar"
                 Grid.Row="2"
                 Title="Note"
                 Severity="Warning"
                 IsOpen="False"
                 IsClosable="True" />

        <Border Grid.Row="3" Style="{StaticResource TableCardStyle}" Padding="6">
            <ListView x:Name="ServicesList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ServiceRow">
                        <Grid ColumnSpacing="14" Padding="4,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- وضعیت -->
                            <Border Style="{StaticResource ChipBorderStyle}" MinWidth="104" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Ellipse Width="7" Height="7" Fill="{x:Bind StatusBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind Status}" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="{x:Bind DisplayName}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button Style="{StaticResource ToolbarButtonStyle}" Padding="10,5" Click="Start_Click" ToolTipService.ToolTip="Start">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE768;" FontSize="12" Foreground="{StaticResource PulseOkBrush}" />
                                        <TextBlock Text="{x:Bind TxtStart}" FontSize="13" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ToolbarButtonStyle}" Padding="10,5" Click="Stop_Click" ToolTipService.ToolTip="Stop">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE71A;" FontSize="12" Foreground="{StaticResource PulseDangerBrush}" />
                                        <TextBlock Text="{x:Bind TxtStop}" FontSize="13" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ToolbarButtonStyle}" Padding="10,5" Click="Restart_Click" ToolTipService.ToolTip="Restart">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind TxtRestart}" FontSize="13" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>
