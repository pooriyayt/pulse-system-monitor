<Page
    x:Class="TaskManagerPro.Views.NetworkConnectionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TaskManagerPro.Controls"
    xmlns:models="using:TaskManagerPro.Models"
    NavigationCacheMode="Required"
    KeyboardAcceleratorPlacementMode="Hidden">

    <!-- هات‌کی‌های این صفحه -->
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FindAccel_Invoked" />
        <KeyboardAccelerator Key="F5" Invoked="RefreshAccel_Invoked" />
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <!-- منوی راست‌کلیک ردیف‌ها -->
        <MenuFlyout x:Key="RowMenu" Opening="RowMenu_Opening">
            <MenuFlyoutItem x:Name="MenuEndProcess" Text="End process" Click="EndProcess_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE711;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem x:Name="MenuCopyLocal" Text="Copy local address" Click="CopyLocal_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8C8;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="MenuCopyRemote" Text="Copy remote address" Click="CopyRemote_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8C8;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Name="MenuCopyRow" Text="Copy details" Click="CopyRow_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8C8;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem x:Name="MenuOpenLocation" Text="Open file location" Click="OpenLocation_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE838;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </Page.Resources>

    <Grid Padding="32,24,32,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:IconBadge Glyph="&#xE968;" Size="44" VerticalAlignment="Center" />
            <TextBlock x:Name="PageTitle" Grid.Column="1" Text="Network Connections"
                       Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Opacity="0.7"
                       Text="{x:Bind ViewModel.Summary, Mode=OneWay}" />
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="SearchBox"
                     PlaceholderText="Search port, process or IP...  (Ctrl+F)"
                     Width="300"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox x:Name="FilterCombo" Width="150"
                      SelectedIndex="{x:Bind ViewModel.ProtocolFilter, Mode=TwoWay}">
                <ComboBoxItem Content="All" />
                <ComboBoxItem Content="TCP" />
                <ComboBoxItem Content="UDP" />
                <ComboBoxItem Content="Listening" />
            </ComboBox>
            <Button Click="Refresh_Click" ToolTipService.ToolTip="Refresh (F5)">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock x:Name="RefreshLabel" Text="Refresh" />
                </StackPanel>
            </Button>
            <ToggleButton IsChecked="{x:Bind ViewModel.IsPaused, Mode=TwoWay}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE769;" FontSize="14" />
                    <TextBlock x:Name="PauseLabel" Text="Pause" />
                </StackPanel>
            </ToggleButton>
        </StackPanel>

        <InfoBar x:Name="NoteBar"
                 Grid.Row="2"
                 Title="Note"
                 Severity="Warning"
                 IsOpen="False"
                 IsClosable="True" />

        <!-- سرستون‌ها -->
        <Grid Grid.Row="3" Padding="28,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="160" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="120" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="HdrProcess" Text="Process" Style="{StaticResource ColumnHeaderStyle}" />
            <TextBlock x:Name="HdrPid" Grid.Column="1" Text="PID" Style="{StaticResource ColumnHeaderStyle}" />
            <TextBlock x:Name="HdrProto" Grid.Column="2" Text="Protocol" Style="{StaticResource ColumnHeaderStyle}" />
            <TextBlock x:Name="HdrLocal" Grid.Column="3" Text="Local address" Style="{StaticResource ColumnHeaderStyle}" />
            <TextBlock x:Name="HdrRemote" Grid.Column="4" Text="Remote address" Style="{StaticResource ColumnHeaderStyle}" />
            <TextBlock x:Name="HdrState" Grid.Column="5" Text="State" Style="{StaticResource ColumnHeaderStyle}" />
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource TableCardStyle}" Padding="6">
        <ListView x:Name="ConnList"
                  SelectionMode="Single"
                  ItemsSource="{x:Bind ViewModel.Rows}">
            <ListView.ItemContainerTransitions>
                <TransitionCollection />
            </ListView.ItemContainerTransitions>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ConnectionRow">
                    <Grid ColumnSpacing="12" Padding="0,4" Background="Transparent"
                          ContextFlyout="{StaticResource RowMenu}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" MinWidth="160" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Grid Width="18" Height="18" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xECAA;" FontSize="14" Visibility="{x:Bind FallbackVisibility, Mode=OneWay}" />
                                <Image Source="{x:Bind Icon, Mode=OneWay}" Width="18" Height="18" />
                            </Grid>
                            <TextBlock Text="{x:Bind ProcessName}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{x:Bind ProcessPath}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{x:Bind PidText}" VerticalAlignment="Center" Opacity="0.8" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Protocol}" VerticalAlignment="Center" Opacity="0.8" />
                        <TextBlock Grid.Column="3" Text="{x:Bind LocalEndpoint}" VerticalAlignment="Center"
                                   FontFamily="Consolas" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="False"
                                   FlowDirection="LeftToRight" TextAlignment="DetectFromContent" />
                        <TextBlock Grid.Column="4" Text="{x:Bind RemoteEndpoint}" VerticalAlignment="Center"
                                   FontFamily="Consolas" TextTrimming="CharacterEllipsis"
                                   FlowDirection="LeftToRight" TextAlignment="DetectFromContent" />
                        <TextBlock Grid.Column="5" Text="{x:Bind StateText, Mode=OneWay}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        </Border>
    </Grid>
</Page>
