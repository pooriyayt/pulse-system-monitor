<Page
    x:Class="TaskManagerPro.Views.StartupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:TaskManagerPro.Models"
    xmlns:controls="using:TaskManagerPro.Controls"
    NavigationCacheMode="Required">

    <Grid Padding="32,24,32,20" RowSpacing="16">
        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="24" />
            </TransitionCollection>
        </Grid.ChildrenTransitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- سرتیتر -->
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="14">
                <controls:IconBadge Glyph="&#xE7B5;" Size="44" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="StartupTitle" Text="Startup Apps" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock x:Name="StartupSubtitle" Text="Programs that start automatically with Windows"
                               Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource ToolbarButtonStyle}" Click="Refresh_Click" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock x:Name="RefreshBtnLabel" Text="Refresh" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- اجرای خودکار خود Pulse هنگام بوت ویندوز -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="18,14">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:IconBadge Glyph="&#xE9D9;" Size="36" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <ToggleSwitch x:Name="PulseStartupToggle"
                                  Header="Start Pulse automatically when Windows starts"
                                  Toggled="PulseStartup_Toggled" />
                    <TextBlock x:Name="PulseStartupNote"
                               Text="When the system tray is enabled, Pulse starts silently in the tray."
                               Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <InfoBar x:Name="ErrorBar"
                 Grid.Row="2"
                 Title="Error"
                 Severity="Error"
                 IsOpen="False"
                 IsClosable="True" />

        <!-- لیست برنامه‌ها -->
        <Border Grid.Row="3" Style="{StaticResource TableCardStyle}">
          <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource TableHeaderBorderStyle}">
                <Grid ColumnSpacing="14" Padding="64,0,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="HdrApp" Text="App" Style="{StaticResource ColumnHeaderStyle}" />
                    <TextBlock x:Name="HdrSource" Grid.Column="1" Text="Registered in" Style="{StaticResource ColumnHeaderStyle}" />
                    <TextBlock x:Name="HdrImpact" Grid.Column="2" Text="Boot impact" Style="{StaticResource ColumnHeaderStyle}" />
                    <TextBlock x:Name="HdrEnabled" Grid.Column="3" Text="Enabled" Style="{StaticResource ColumnHeaderStyle}" />
                </Grid>
            </Border>
            <ListView x:Name="StartupList" Grid.Row="1" SelectionMode="None" Margin="6">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:StartupItem">
                        <Grid ColumnSpacing="14" Padding="4,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- آیکون برنامه (استخراج‌شده از EXE) -->
                            <Border Width="40" Height="40" CornerRadius="10" VerticalAlignment="Center"
                                    Background="{ThemeResource PulseSurfaceBrush}"
                                    BorderBrush="{ThemeResource PulseDividerBrush}" BorderThickness="1">
                                <Grid Width="24" Height="24">
                                    <FontIcon Glyph="&#xECAA;" FontSize="18"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              Visibility="{x:Bind FallbackVisibility, Mode=OneWay}" />
                                    <Image Source="{x:Bind Icon, Mode=OneWay}" Width="24" Height="24" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Command}" Style="{StaticResource MutedTextStyle}"
                                           ToolTipService.ToolTip="{x:Bind Command}" />
                            </StackPanel>

                            <!-- محل ثبت -->
                            <Border Grid.Column="2" Style="{StaticResource ChipBorderStyle}" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind LocationText}" FontSize="11"
                                           Foreground="{ThemeResource PulseMutedTextBrush}" />
                            </Border>

                            <!-- تأثیر تخمینی روی زمان بوت -->
                            <Border Grid.Column="3" Style="{StaticResource ChipBorderStyle}" VerticalAlignment="Center"
                                    MinWidth="180" ToolTipService.ToolTip="{x:Bind ImpactTip}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Ellipse Width="7" Height="7" Fill="{x:Bind ImpactBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind ImpactLabel}" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>

                            <ToggleSwitch Grid.Column="4"
                                          IsOn="{x:Bind Enabled, Mode=OneWay}"
                                          Toggled="Toggle_Toggled"
                                          OnContent=""
                                          OffContent=""
                                          MinWidth="0"
                                          VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
          </Grid>
        </Border>
    </Grid>
</Page>
