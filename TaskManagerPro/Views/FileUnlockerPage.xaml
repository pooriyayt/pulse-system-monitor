<Page
    x:Class="TaskManagerPro.Views.FileUnlockerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:TaskManagerPro.Models"
    NavigationCacheMode="Required">

    <Grid Padding="24,16,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <FontIcon Glyph="&#xE785;" FontSize="24"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock x:Name="PageTitle" Text="File Unlocker" Style="{StaticResource TitleTextBlockStyle}" />
        </StackPanel>

        <!-- ناحیه‌ی Drag & Drop -->
        <Border x:Name="DropZone" Grid.Row="1"
                Style="{StaticResource CardBorderStyle}"
                AllowDrop="True"
                DragOver="DropZone_DragOver"
                DragLeave="DropZone_DragLeave"
                Drop="DropZone_Drop"
                Padding="24">
            <StackPanel Spacing="12" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE8B5;" FontSize="36" Opacity="0.7" />
                <TextBlock x:Name="DropHint" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           Text="Drag a file or folder here to see which processes are locking it" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <Button Click="BrowseFile_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                            <TextBlock x:Name="BrowseFileLabel" Text="Browse file" />
                        </StackPanel>
                    </Button>
                    <Button Click="BrowseFolder_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                            <TextBlock x:Name="BrowseFolderLabel" Text="Browse folder" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- مسیر دستی (وقتی برنامه ادمین است، Drag از Explorer و Picker ویندوز کار نمی‌کنند) -->
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PathBox" PlaceholderText="Or paste a path, e.g. C:\Users\me\file.docx"
                     FlowDirection="LeftToRight" KeyDown="PathBox_KeyDown" />
            <Button x:Name="ScanBtn" Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="Scan_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE721;" FontSize="14" />
                    <TextBlock x:Name="ScanLabel" Text="Scan" />
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar x:Name="StatusBar" Grid.Row="3" IsOpen="False" IsClosable="True" />

        <!-- نوار نتیجه -->
        <Grid x:Name="ResultHeader" Grid.Row="4" ColumnSpacing="8" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="ResultTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="ResultPath" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis"
                           FlowDirection="LeftToRight" TextAlignment="DetectFromContent" />
            </StackPanel>
            <ProgressRing x:Name="Busy" Grid.Column="1" Width="20" Height="20" IsActive="False" />
            <Button x:Name="UnlockAllBtn" Grid.Column="2" Click="UnlockAll_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE785;" FontSize="14" />
                    <TextBlock x:Name="UnlockAllLabel" Text="Unlock (end all)" />
                </StackPanel>
            </Button>
        </Grid>

        <ListView x:Name="LockList" Grid.Row="5" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:LockerRow">
                    <Grid ColumnSpacing="12" Padding="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="32" Height="32" VerticalAlignment="Center">
                            <FontIcon Glyph="{x:Bind FallbackGlyph}" FontSize="22" Visibility="{x:Bind FallbackVisibility}" />
                            <Image Source="{x:Bind Icon}" Width="32" Height="32" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Subtitle}" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind PathText}" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis"
                                       FlowDirection="LeftToRight" TextAlignment="DetectFromContent"
                                       ToolTipService.ToolTip="{x:Bind PathText}" />
                        </StackPanel>
                        <Button Grid.Column="2" Click="EndProcess_Click" IsEnabled="{x:Bind CanEnd}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE711;" FontSize="13" />
                                <TextBlock Text="{x:Bind TxtEnd}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
