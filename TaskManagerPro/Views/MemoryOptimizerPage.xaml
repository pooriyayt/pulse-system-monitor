<Page
    x:Class="TaskManagerPro.Views.MemoryOptimizerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <ScrollViewer>
        <StackPanel Padding="24,16,24,24" Spacing="16">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition IsStaggeringEnabled="True" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="&#xEEA0;" FontSize="24"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock x:Name="PageTitle" Text="Memory Optimizer" Style="{StaticResource TitleTextBlockStyle}" />
            </StackPanel>

            <InfoBar x:Name="AdminBar" Severity="Informational" IsOpen="False" IsClosable="True" />

            <!-- گیج مصرف + آمار زنده -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="24">
                <Grid ColumnSpacing="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="180" Height="180" VerticalAlignment="Center">
                        <ProgressRing x:Name="UsageRing" Width="180" Height="180"
                                      IsIndeterminate="False" Minimum="0" Maximum="100" Value="0"
                                      Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="UsagePercent" Text="0%" FontSize="40" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" FlowDirection="LeftToRight" />
                            <TextBlock x:Name="UsageLabel" Text="In use" Opacity="0.7" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <VariableSizedWrapGrid Grid.Column="1" Orientation="Horizontal" ItemWidth="190" ItemHeight="84"
                                           VerticalAlignment="Center">
                        <StackPanel Margin="0,0,12,12" Spacing="2">
                            <TextBlock x:Name="InUseLabel" Text="In use" Opacity="0.7" />
                            <TextBlock x:Name="InUseValue" Text="—" FontSize="24" FontWeight="SemiBold" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,12" Spacing="2">
                            <TextBlock x:Name="AvailLabel" Text="Available" Opacity="0.7" />
                            <TextBlock x:Name="AvailValue" Text="—" FontSize="24" FontWeight="SemiBold" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,12" Spacing="2">
                            <TextBlock x:Name="StandbyLabel" Text="Standby cache" Opacity="0.7" />
                            <TextBlock x:Name="StandbyValue" Text="—" FontSize="24" FontWeight="SemiBold" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,12" Spacing="2">
                            <TextBlock x:Name="TotalLabel" Text="Total" Opacity="0.7" />
                            <TextBlock x:Name="TotalValue" Text="—" FontSize="24" FontWeight="SemiBold" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,12" Spacing="2">
                            <TextBlock x:Name="SessionLabel" Text="Freed this session" Opacity="0.7" />
                            <TextBlock x:Name="SessionValue" Text="0 MB" FontSize="24" FontWeight="SemiBold" FlowDirection="LeftToRight" HorizontalAlignment="Left"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </VariableSizedWrapGrid>
                </Grid>
            </Border>

            <!-- گزینه‌ها -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="4">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE9F5;" FontSize="18" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TrimTitle" Text="Trim working sets" />
                            <TextBlock x:Name="TrimDesc" Opacity="0.6" FontSize="12" TextWrapping="Wrap"
                                       Text="Asks every process to release memory it is not actively using." />
                        </StackPanel>
                        <ToggleSwitch x:Name="TrimToggle" Grid.Column="2" IsOn="True" OnContent="" OffContent="" MinWidth="0" />
                    </Grid>
                    <MenuFlyoutSeparator Margin="0,6" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE74D;" FontSize="18" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="PurgeTitle" Text="Clear standby list" />
                            <TextBlock x:Name="PurgeDesc" Opacity="0.6" FontSize="12" TextWrapping="Wrap"
                                       Text="Frees cached file data so it becomes free memory. Requires administrator." />
                        </StackPanel>
                        <ToggleSwitch x:Name="PurgeToggle" Grid.Column="2" IsOn="True" OnContent="" OffContent="" MinWidth="0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- اقدام -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="OptimizeBtn" Style="{StaticResource AccentButtonStyle}" Click="Optimize_Click"
                        Padding="24,10" FontSize="16">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE945;" FontSize="16" />
                        <TextBlock x:Name="OptimizeLabel" Text="Optimize memory" />
                    </StackPanel>
                </Button>
                <ProgressRing x:Name="BusyRing" Width="24" Height="24" IsActive="False" />
            </StackPanel>

            <InfoBar x:Name="ResultBar" IsOpen="False" IsClosable="True" />
        </StackPanel>
    </ScrollViewer>
</Page>
