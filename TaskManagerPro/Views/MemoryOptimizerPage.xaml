<Page
    x:Class="TaskManagerPro.Views.MemoryOptimizerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TaskManagerPro.Controls"
    NavigationCacheMode="Required">

    <ScrollViewer>
        <StackPanel Padding="32,24,32,32" Spacing="16" MaxWidth="1200">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="24" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>

            <!-- سرتیتر -->
            <StackPanel Orientation="Horizontal" Spacing="14">
                <controls:IconBadge Glyph="&#xE945;" Size="44" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PageTitle" Text="Memory Optimizer" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock x:Name="PageSubtitle" Text="Free up RAM that apps are holding but not using" Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>
            </StackPanel>

            <!-- دسترسی ادمین: قدرت کامل -->
            <Border x:Name="AdminCard" Style="{StaticResource CardBorderStyle}" Padding="18,14">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:IconBadge Glyph="&#xE7EF;" Tint="#FF9F0A" Size="36" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AdminTitle" Text="Unlock full cleanup" FontWeight="SemiBold" />
                        <TextBlock x:Name="AdminDesc" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                                   Text="Clearing the standby cache and file cache frees much more memory, but needs administrator rights." />
                    </StackPanel>
                    <Button x:Name="ElevateBtn" Grid.Column="2" Style="{StaticResource ToolbarButtonStyle}" Click="Elevate_Click" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7EF;" FontSize="13" />
                            <TextBlock x:Name="ElevateLabel" Text="Restart as administrator" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
            <InfoBar x:Name="AdminBar" IsOpen="False" IsClosable="True" />

            <!-- ================= کارت اصلی ================= -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="28">
                <Grid ColumnSpacing="36" RowSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- گیج بزرگ -->
                    <Grid Width="210" Height="210" VerticalAlignment="Center">
                        <controls:RingGauge x:Name="UsageRing" Thickness="14" UseLoadColors="True" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="UsagePercent" Text="0%" FontSize="46" FontWeight="Bold"
                                       FontFamily="{StaticResource DisplayFont}"
                                       HorizontalAlignment="Center" FlowDirection="LeftToRight" />
                            <TextBlock x:Name="UsageLabel" Text="In use" Style="{StaticResource MutedTextStyle}" FontSize="13" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Column="1" Spacing="18" VerticalAlignment="Center">
                        <!-- نوار ترکیب حافظه: استفاده / کش / آزاد -->
                        <StackPanel Spacing="10">
                            <Grid Height="14" CornerRadius="7" Background="{ThemeResource PulseTrackBrush}" FlowDirection="LeftToRight">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="UsedCol" Width="0*" />
                                    <ColumnDefinition x:Name="CacheCol" Width="0*" />
                                    <ColumnDefinition x:Name="FreeCol" Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{ThemeResource AccentFillColorDefaultBrush}" />
                                <Border Grid.Column="1" Background="#8E8E93" Opacity="0.7" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="18">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="8" Height="8" Fill="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="LegendUsed" Text="In use" Style="{StaticResource MutedTextStyle}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="8" Height="8" Fill="#8E8E93" VerticalAlignment="Center" />
                                    <TextBlock x:Name="LegendCache" Text="Standby cache" Style="{StaticResource MutedTextStyle}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="8" Height="8" Fill="{ThemeResource PulseTrackBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="LegendFree" Text="Free" Style="{StaticResource MutedTextStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- آمار -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource TileBorderStyle}">
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="InUseLabel" Text="In use" Style="{StaticResource EyebrowStyle}" />
                                    <TextBlock x:Name="InUseValue" Text="—" Style="{StaticResource StatValueStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource TileBorderStyle}">
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="AvailLabel" Text="Available" Style="{StaticResource EyebrowStyle}" />
                                    <TextBlock x:Name="AvailValue" Text="—" Style="{StaticResource StatValueStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource TileBorderStyle}">
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="StandbyLabel" Text="Standby cache" Style="{StaticResource EyebrowStyle}" />
                                    <TextBlock x:Name="StandbyValue" Text="—" Style="{StaticResource StatValueStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource TileBorderStyle}">
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="TotalLabel" Text="Total" Style="{StaticResource EyebrowStyle}" />
                                    <TextBlock x:Name="TotalValue" Text="—" Style="{StaticResource StatValueStyle}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- اقدام -->
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="OptimizeBtn" Style="{StaticResource AccentPillButtonStyle}" Click="Optimize_Click"
                                    Padding="26,12" FontSize="15" CornerRadius="14">
                                <Grid>
                                    <StackPanel x:Name="OptimizeContent" Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE945;" FontSize="16" />
                                        <TextBlock x:Name="OptimizeLabel" Text="Free up memory" />
                                    </StackPanel>
                                    <ProgressRing x:Name="BusyRing" Width="20" Height="20" IsActive="False" Foreground="White" />
                                </Grid>
                            </Button>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="SessionLabel" Text="Freed this session" Style="{StaticResource EyebrowStyle}" />
                                <TextBlock x:Name="SessionValue" Text="0 MB" Style="{StaticResource StatValueStyle}"
                                           Foreground="{StaticResource PulseOkBrush}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- نتیجه‌ی آخرین بهینه‌سازی -->
            <Border x:Name="ResultCard" Style="{StaticResource CardBorderStyle}" Visibility="Collapsed" Padding="22,18">
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:IconBadge x:Name="ResultIcon" Glyph="&#xE73E;" Tint="#30D158" Size="48" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="ResultTitle" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="Bold" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                        <TextBlock x:Name="ResultDetail" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" FlowDirection="LeftToRight">
                        <StackPanel>
                            <TextBlock x:Name="BeforeLabel" Text="Free before" Style="{StaticResource EyebrowStyle}" />
                            <TextBlock x:Name="BeforeValue" Style="{StaticResource StatValueStyle}" />
                        </StackPanel>
                        <FontIcon Glyph="&#xE72A;" FontSize="14" Foreground="{ThemeResource PulseMutedTextBrush}" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                        <StackPanel>
                            <TextBlock x:Name="AfterLabel" Text="Free after" Style="{StaticResource EyebrowStyle}" />
                            <TextBlock x:Name="AfterValue" Style="{StaticResource StatValueStyle}" Foreground="{StaticResource PulseOkBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <InfoBar x:Name="ResultBar" IsOpen="False" IsClosable="True" />

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- گزینه‌ها + بهینه‌سازی خودکار -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="OptionsHeader" Text="Cleanup options" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,8" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:IconBadge Glyph="&#xE9F5;" Size="30" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TrimTitle" Text="Trim working sets" FontWeight="SemiBold" />
                                <TextBlock x:Name="TrimDesc" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                                           Text="Asks every process to release memory it is not actively using." />
                            </StackPanel>
                            <ToggleSwitch x:Name="TrimToggle" Grid.Column="2" IsOn="True" OnContent="" OffContent="" MinWidth="0" />
                        </Grid>
                        <Rectangle Height="1" Fill="{ThemeResource PulseDividerBrush}" Margin="0,8" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:IconBadge Glyph="&#xE74D;" Tint="#FF9F0A" Size="30" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="PurgeTitle" Text="Clear standby &amp; file cache" FontWeight="SemiBold" />
                                <TextBlock x:Name="PurgeDesc" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                                           Text="Writes modified pages to disk, then frees cached file data. Requires administrator." />
                            </StackPanel>
                            <ToggleSwitch x:Name="PurgeToggle" Grid.Column="2" IsOn="True" OnContent="" OffContent="" MinWidth="0" />
                        </Grid>
                        <Rectangle Height="1" Fill="{ThemeResource PulseDividerBrush}" Margin="0,8" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:IconBadge Glyph="&#xE916;" Tint="#30D158" Size="30" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="AutoTitle" Text="Automatic cleanup" FontWeight="SemiBold" />
                                <TextBlock x:Name="AutoDesc" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="AutoToggle" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="Auto_Toggled" />
                        </Grid>
                        <Slider x:Name="AutoSlider" Minimum="60" Maximum="95" StepFrequency="5" Margin="42,4,0,0"
                                ValueChanged="AutoSlider_Changed" />
                        <TextBlock x:Name="AutoLast" Style="{StaticResource MutedTextStyle}" Margin="42,0,0,0" />
                    </StackPanel>
                </Border>

                <!-- پرمصرف‌ترین برنامه‌ها -->
                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="TopHeader" Text="Biggest memory users" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,4" />
                        <StackPanel x:Name="TopPanel" Spacing="12" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
